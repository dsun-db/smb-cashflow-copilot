## Q: Which industries have the highest average shortfall probability?
status=COMPLETED  (21.2s)
Genie: You want to see which industries have the highest average probability of running out of cash soon, ranked from highest to lowest.
SQL:
WITH `industry_avg` AS (
  SELECT
    `industry`,
    ROUND(AVG(`shortfall_prob`) * 100, 1) AS `avg_shortfall_pct`
  FROM `serverless_stable_0dcqtv_catalog`.`smb_cashflow`.`account_cashflow_health`
  WHERE `industry` IS NOT NULL
    AND `shortfall_prob` IS NOT NULL
  GROUP BY `industry`
), `ranked` AS (
  SELECT
    `industry`,
    `avg_shortfall_pct`,
    RANK() OVER (ORDER BY `avg_shortfall_pct` DESC) AS `industry_rank`
  FROM `industry_avg`
)
SELECT
  `industry`,
  `avg_shortfall_pct`,
  `industry_rank`
FROM `ranked`
ORDER BY `industry_rank` ASC, `avg_shortfall_pct` DESC, `industry` ASC
